# Configuración del Bot de Discord
# Copia este archivo a .env y completa los valores

# Token del bot de Discord (obligatorio)
DISCORD_TOKEN=tu_token_aqui

# ID de la aplicación de Discord (obligatorio)  
CLIENT_ID=tu_client_id_aqui

# Prefijo para comandos (opcional, por defecto: !)
PREFIX=!

# Color por defecto para embeds (opcional)
EMBED_COLOR=#FFD700

# Roles con permisos de administrador (separados por comas)
ADMIN_ROLES=Admin,Moderador,Staff

# Nombre de la categoría para tickets
TICKET_CATEGORY=TICKETS

# Nombre del canal de logs
LOG_CHANNEL=logs